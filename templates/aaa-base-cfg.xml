<config-template xmlns="http://tail-f.com/ns/config/1.0">
    <devices xmlns="http://tail-f.com/ns/ncs">
        <device>
            <name>{$DEVICE}</name>
            <config>
                <aaa xmlns="http://tail-f.com/ned/cisco-nx">
                    <group>
                        <server>
                            <tacacs-plus>
                                <id>{/security/aaa/group}</id>
                                <source-interface>/{management/interface/name}</source-interface>
                                <deadtime>{/security/aaa/deadtime}</deadtime>
                            </tacacs-plus>
                        </server>
                    </group>
                    <authentication>
                        <login>
                            <console>
                                <fallback>local</fallback>
                            </console>
                            <default>
                                <group>{/security/aaa/group}</group>
                                <fallback>local</fallback>
                            </default>
                        </login>
                    </authentication>
                </aaa>
                <ip xmlns="http://tail-f.com/ned/cisco-nx">
                    <tacacs>
                        <source-interface>{/management/interface/name}</source-interface>
                    </tacacs>
                </ip>
            </config>
        </device>
    </devices>
</config-template>