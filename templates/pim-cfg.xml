<config-template xmlns="http://tail-f.com/ns/config/1.0">
    <devices xmlns="http://tail-f.com/ns/ncs">
        <device>
            <name>{$DEVICE}</name>
            <config>
                <ip xmlns="http://tail-f.com/ned/cisco-nx">
                    <pim>
                        <register-source>{/management/interface/name}</register-source>
                        <rp-address>
                            <ip-address>{/pim/rp}</ip-address>
                            <group-list>
                                <group-range-prefix>224.0.0.0/4</group-range-prefix>
                                <override/>
                            </group-list>
                        </rp-address>
                        <ssm>
                            <range>
                                <list-of-group>{/pim/ssm-range}</list-of-group>
                            </range>
                        </ssm>
                    </pim>
                </ip>
            </config>
        </device>
    </devices>
</config-template>