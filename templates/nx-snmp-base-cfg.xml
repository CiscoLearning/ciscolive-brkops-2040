<config-template xmlns="http://tail-f.com/ns/config/1.0">
    <devices xmlns="http://tail-f.com/ns/ncs">
        <device>
            <name>{$DEVICE}</name>
            <config>
                <snmp-server xmlns="http://tail-f.com/ned/cisco-nx">
                    <contact>{/contact}</contact>
                    <?if {$COMMUNITY != ""}?>
                    <community>
                        <snmp-community-string>{$COMMUNITY}</snmp-community-string>
                        <group>network-operator</group>
                    </community>
                    <community-config>
                        <community>
                            <snmp-community-string>{$COMMUNITY}</snmp-community-string>
                            <use-ipv4acl>{/security/v4-mgmt-acl}</use-ipv4acl>
                            <use-ipv6acl>{/security/v6-mgmt-acl}</use-ipv6acl>
                        </community>
                    </community-config>
                    <?end?>
                    <location>{$LOCATION}</location>
                    <source-interface>
                        <informs>{/management/interface/name}</informs>
                    </source-interface>
                    <user>
                        <name>{/snmp/user}</name>
                        <role>network-admin</role>
                        <auth>
                            <sha>{$PASSWORD}</sha>
                            <priv>
                                <aes-128>{$PASSWORD}</aes-128>
                            </priv>
                        </auth>
                    </user>
                    <user-config>
                        <user>
                            <name>{/snmp/user}</name>
                            <use-ipv4acl>{/security/v4-mgmt-acl}</use-ipv4acl>
                            <use-ipv6acl>{/security/v6-mgmt-acl}</use-ipv6acl>
                        </user>
                    </user-config>
                    <globalEnforcePriv/>
                </snmp-server>
            </config>
        </device>
    </devices>
</config-template>